# Copy to .env and adjust. Docker Compose reads .env from this directory for ${VAR} substitution.
# cp .env.example .env

# --- Kafka ---
# Host port published to your Mac (inside the stack, brokers are still kafka:9092).
# Default 39092 avoids conflicts with other local stacks that often bind 29092.
KAFKA_HOST_PORT=39092

# From your Mac or a non-Docker client, use localhost:${KAFKA_HOST_PORT}.
# Inside Docker network, leave defaults in app code / use kafka:9092.
KAFKA_BROKER_HOST=localhost

# --- HDFS Namenode (host side) ---
HDFS_NAMENODE_UI_PORT=9870
HDFS_NAMENODE_RPC_PORT=9000

# --- HttpFS (host side) ---
# Single-endpoint WebHDFS gateway for Colab over ngrok.
HTTPFS_PORT=14000

# --- Spark (host side) ---
SPARK_MASTER_UI_PORT=8080
SPARK_MASTER_PORT=7077
SPARK_DRIVER_UI_PORT=4040

# --- Hive ---
HIVE_SERVER_PORT=10000
HIVE_SERVER_WEBUI_PORT=10002

# --- Streamlit dashboard ---
STREAMLIT_PORT=8501

# --- Local Plotly Dash dashboard over Hive/ngrok ---
# For local Hive, keep localhost:10000. For an ngrok TCP tunnel, set HIVE_HOST
# to the assigned TCP host and HIVE_PORT to the assigned TCP port.
HIVE_HOST=localhost
HIVE_PORT=10000
HIVE_USER=root
HIVE_DATABASE=supply_chain
HIVE_AUTH=NOSASL
DASH_PORT=8050
DASH_DEBUG=false
DASH_SQL_MODE=hive

# Optional fallback/alternate source for the dashboard when HiveServer2 is not
# reachable. This uses the same real analytics parquet on HDFS through HttpFS.
DASH_DATA_MODE=auto
HDFS_WEBHDFS_URL=https://YOUR-HTTPFS.ngrok-free.dev
HDFS_WEBHDFS_USER=root
HDFS_ANALYTICS_BASE=/supply-chain/analytics

# Local path where notebook-exported per-prediction SHAP parquet is available.
# Expected files: ${SHAP_LOCAL_PATH}/brent.parquet, .../wti.parquet, etc.
SHAP_LOCAL_PATH=/supply-chain/analytics/shap_local

# --- Hive metastore database (PostgreSQL) ---
METASTORE_DB_NAME=metastore
METASTORE_DB_USER=hive
# Match POSTGRES_PASSWORD for hive-metastore-db (change for anything beyond local dev).
METASTORE_DB_PASSWORD=hive

# --- Airflow ---
# Web UI: http://localhost:${AIRFLOW_WEBSERVER_PORT} (default 8090 — Spark Master UI uses 8080).
AIRFLOW_DB_NAME=airflow
AIRFLOW_DB_USER=airflow
AIRFLOW_DB_PASSWORD=airflow
AIRFLOW_ADMIN_USER=admin
AIRFLOW_ADMIN_PASSWORD=admin
AIRFLOW_WEBSERVER_PORT=8090
AIRFLOW_SECRET_KEY=replace-with-random-string-in-prod

# --- HDFS external endpoint (for Colab training via tunnel) ---
# When training: start ngrok TCP tunnel against the namenode RPC port,
# and set this to the resulting host:port (e.g. 4.tcp.ngrok.io:12345).
# The Colab notebook builds the hdfs:// URI from this.
# Local default (Spark inside the cluster) does not use this var.
HDFS_EXTERNAL_HOST_PORT=localhost:9000
